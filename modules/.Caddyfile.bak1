# Caddyfile for mgeek.in services behind Cloudflare Tunnel
#
# NO TLS config needed here — Cloudflare terminates HTTPS at the edge.
# Traffic from cloudflared arrives at Caddy as plain HTTP on port 80.
# Caddy's only job: route each subdomain to the right local port.
#
# To add a new service:
#   1. Add a block below
#   2. Run: sudo caddy reload --config /etc/nixos/Caddyfile
#   (no nixos-rebuild needed for Caddyfile-only changes)

# ── Global options ────────────────────────────────────────────────────────────
{
	auto_https off
}

# ── Shared snippet — imported by every service block ──────────────────────────
# header_up is a reverse_proxy subdirective — it cannot live here directly.
# Instead we use `request_header` which rewrites the request header at the
# site block level, visible to any directive including reverse_proxy.
(common) {
	encode zstd gzip

	# Security headers sent to the client (browser)
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	# Rewrite the incoming request so backends see the real visitor IP
	# Cloudflare puts the real IP in CF-Connecting-IP.
	# request_header rewrites it into X-Real-IP before reverse_proxy sees it.
	request_header X-Real-IP {http.request.header.CF-Connecting-IP}
}

# ── SSH ──────────────────────────────────────────────────────────────────────
# SSH is handled directly in config.yml ingress (not via Caddy)
# ssh.mgeek.in → ssh://localhost:22  (set in /etc/.cloudflared/config.yml)

# ── Web Services ─────────────────────────────────────────────────────────────

cockpit.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:9090
}

file.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:8091
}

immich.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:2283
}

cups.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:631
}

http://jellyfin.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:8096
}

jenkins.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:8080
}

komodo.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:9120
}

memos.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:5230
}

n8n.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:5678
}

nodeexporter.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:9100
}

novnc.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:6080
}

nvr.mgeek.in {
	import common
	reverse_proxy 192.168.1.245:80
}

ollama.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:8099
}

pihole.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:8085
}

portainer.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:9443
}

printer.mgeek.in {
	import common
	reverse_proxy 192.168.1.212:80
}

rwmarkable.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:1122
}

npm.mgeek.in {
	import common
	reverse_proxy 127.0.0.1:81
}

test.mgeek.in {
	respond "TEST WORKS" 200
}

debug.mgeek.in {
	import common
	header Content-Type "text/plain"
	respond "Request from IP: {http.request.header.CF-Connecting-IP}\nHost: {http.request.host}\nX-Forwarded-For: {http.request.header.X-Forwarded-For}\n" 200
}

# ── Catch-all ─────────────────────────────────────────────────────────────────
# Returns a clear error for unconfigured subdomains instead of a confusing blank page
:80 {
	respond "no route configured for {http.request.host} 404 response from caddy"
}
