# ============================================================
# CADDYFILE
# Multi-Node Caddy + Cloudflare Tunnel + Tailscale Architecture
#
# This same Caddyfile can run on both Node 1 and Node 2.
#
# Cloudflare may send a request to either node through cloudflared.
# Therefore, every Caddy instance must know where every service lives.
#
# Service communication between nodes happens over Tailscale.
# ============================================================


# ============================================================
# MAINTENANCE COMMANDS
# ============================================================

# Enter a temporary environment containing Caddy.
# nix-shell -p caddy


# Format the Caddyfile.
# sudo caddy fmt -w /etc/nixos/modules/Caddyfile


# Validate the Caddyfile before applying changes.
# sudo caddy validate \
#   --config /etc/nixos/modules/Caddyfile \
#   --adapter caddyfile


# Run Caddy manually for testing.
# sudo caddy run \
#   --config /etc/nixos/modules/Caddyfile \
#   --adapter caddyfile


# Reload Caddy without stopping active connections.
# sudo caddy reload \
#   --config /etc/nixos/modules/Caddyfile \
#   --adapter caddyfile


# Recommended safe update command:
#
# 1. Format
# 2. Validate
# 3. Reload only if validation succeeds
#
# sudo caddy fmt -w /etc/nixos/modules/Caddyfile && \
# sudo caddy validate \
#   --config /etc/nixos/modules/Caddyfile \
#   --adapter caddyfile && \
# sudo caddy reload \
#   --config /etc/nixos/modules/Caddyfile \
#   --adapter caddyfile


# Optional shell alias.
#
# Add this to ~/.bashrc or ~/.zshrc:
#
# alias caddyapply='
# sudo caddy fmt -w /etc/nixos/modules/Caddyfile &&
# sudo caddy validate \
#   --config /etc/nixos/modules/Caddyfile \
#   --adapter caddyfile &&
# sudo caddy reload \
#   --config /etc/nixos/modules/Caddyfile \
#   --adapter caddyfile
# '


# Check running Caddy processes.
# ps aux | grep caddy


# Check listening ports.
# sudo ss -tulpn | grep caddy


# Check Caddy logs when running as a systemd service.
# journalctl -u caddy -f


# Reload through systemd if Caddy is managed as a service.
# sudo systemctl reload caddy


# Restart Caddy completely.
# sudo systemctl restart caddy


# Check service status.
# systemctl status caddy


# ============================================================
# GLOBAL OPTIONS
# ============================================================
{
	# Cloudflare Tunnel terminates public TLS.
	# Caddy receives HTTP traffic locally from cloudflared.

	http_port 80

	# Enable only while debugging.
	# debug
}

# ============================================================
# CLUSTER TOPOLOGY
# ============================================================

# Node 1
#
# Primary/common infrastructure services.
#
# Tailscale IP:
# 100.81.210.25


# Node 2
#
# AI, LLM and agent services.
#
# Tailscale IP:
# 100.81.212.102


# ============================================================
# PROXY: SINGLE UPSTREAM
# ============================================================

(proxy) {
	# Compress compatible HTTP responses.
	encode zstd gzip

	# Basic security headers.
	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	# First argument is the upstream address.
	reverse_proxy {args[0]} {
		# Tell upstream that the original external request was HTTPS.
		header_up X-Forwarded-Proto https

		# Forward the original client IP supplied by Cloudflare.
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}

		# Preserve the requested hostname.
		header_up Host {http.request.host}

		# WebSocket Upgrade handling is automatic in Caddy.
		#
		# Immediate flushing is useful for:
		# - WebSockets
		# - Server-Sent Events
		# - Streaming responses
		flush_interval -1
	}
}

# ============================================================
# PROXY_FO: ORDERED FAILOVER
# ============================================================

(proxy_fo) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	# {args} accepts any number of upstream servers.
	#
	# Example:
	#
	# import proxy_fo \
	#   100.81.210.25:8080 \
	#   100.81.212.102:8080
	#
	reverse_proxy {args} {
		# Always prefer the first healthy upstream.
		#
		# Upstream order:
		# args[0] = primary
		# args[1] = first fallback
		# args[2] = second fallback
		lb_policy first

		# Retry another upstream when a connection fails.
		lb_retries 2
		lb_try_interval 250ms

		# Passive health checking.
		#
		# After max_fails failures during fail_duration,
		# the upstream is temporarily considered unhealthy.
		fail_duration 30s
		max_fails 2

		header_up X-Forwarded-Proto https
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up Host {http.request.host}

		flush_interval -1
	}
}

# ============================================================
# PROXY_LB: MULTI-NODE LOAD BALANCING
# ============================================================

(proxy_lb) {
	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
	}

	# {args} accepts any number of upstream servers.
	reverse_proxy {args} {
		# Distribute requests sequentially across healthy upstreams.
		#
		# Example:
		#
		# Request 1 -> Node 1
		# Request 2 -> Node 2
		# Request 3 -> Node 1
		lb_policy round_robin

		# Retry another node when the selected upstream fails.
		lb_retries 2
		lb_try_interval 250ms

		# Passive health checking.
		fail_duration 30s
		max_fails 2

		header_up X-Forwarded-Proto https
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up Host {http.request.host}

		flush_interval -1
	}
}

