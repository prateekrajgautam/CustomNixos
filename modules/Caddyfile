# Portainer uses HTTPS internally.
http://portainer.mgeek.in {
	reverse_proxy https://100.81.210.25:9443 {
		transport http {
			# Required when Portainer uses its internal/self-signed certificate.
			tls_insecure_skip_verify
		}

		header_up X-Forwarded-Proto https
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
		header_up Host {http.request.host}
	}
}

