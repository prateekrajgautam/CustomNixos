# ============================================================
# DEBUG ENDPOINT
#
# Keep disabled in production unless actively debugging.
# ============================================================

http://debug.mgeek.in {
	log {
		output stdout
		level DEBUG
	}

	respond "DEBUG"
}

# ============================================================
# HEALTH ENDPOINT
#
# This endpoint confirms that Caddy itself is reachable.
#
# It is NOT automatically used for upstream health checking.
#
# Useful for:
# - Manual curl tests
# - Cloudflare Load Balancer health checks
# - Monitoring systems
# ============================================================

http://health.mgeek.in {
	respond "OK" 200
}

